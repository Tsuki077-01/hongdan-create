{
  "name": "hongdan",
  "productName": "红蛋",
  "version": "1.0.0",
  "description": "一颗住在屏幕底部的珊瑚橘色蛋蛋桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-packager . 红蛋 --platform=darwin --arch=arm64 --out=dist --overwrite --app-bundle-id=com.yyq.hongdan --icon=build/icon.icns --ignore=^/dist --ignore=^/test --ignore=^/scripts --ignore=^/build --ignore=^/release --ignore=^/README.md",
    "test": "HONGDAN_TEST=1 electron . --no-sandbox",
    "release:mac": "npm run dist:mac && scripts/sign-and-zip.sh"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.4.11"
  }
}
